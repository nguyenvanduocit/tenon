# Build artifacts. Both trees live inside .build/ (SwiftPM and Xcode derived data
# share one path); /build/ catches the stray Xcode tree that appears when a build
# runs without -derivedDataPath. See scripts/prune-build-cache.sh.
.build/
/build/
# The vendored grammar compiles in place, so its object tree lands beside the
# sources that ARE tracked (6.2 MB of it).
Vendor/*/build/

# Release artifacts built by scripts/release.sh — a signed app, its archive, checksums
# and the generated cask. They are outputs of a tagged commit, published to GitHub
# Releases rather than committed; a few hundred MB of them would otherwise land here.
/dist/

# Prebuilt GhosttyKit — downloaded by scripts/setup-ghosttykit.sh, never committed.
# Only the script and GhosttyKit/module.modulemap are tracked (see CLAUDE.md).
/GhosttyKit.xcframework/
/GhosttyKit/ghostty.h
/Resources/

# Local release configuration — the signing identity, team, and Apple ID this machine
# cuts releases with. Tracked as .env.example with the values removed; the real file
# stays here. Secrets proper (the notarization password) live in the keychain profile
# .env names, not in .env itself. See docs/releasing.md.
.env
.env.local

# Cloned external codebases studied during design (each is its own git repo;
# ~672 MB). Read for reference; never this project's source. Distinct from
# Vendor/, which is tracked and compiled into the app.
references/

# Agent / tooling runtime state
.omc/
.repowise/
.repowise-workspace/
.repowise-workspace.yaml
.claude/
.codex/
.mcp.json
.remember/
.recap/
skills-lock.json

# macOS
.DS_Store
