{
  "id": "dev.tenon.browser",
  "name": "browser",
  "version": "1.0.0",
  "displayName": "Browser",
  "icon": "globe",
  "permissions": ["web.view", "workspace.control"],
  "intents": {
    "uses": [
      "browser.surface.load.v1",
      "browser.surface.back.v1",
      "browser.surface.forward.v1",
      "browser.surface.reload.v1",
      "workspace.content.open.v1"
    ],
    "provides": [
      {
        "name": "dev.tenon.browser.open.v1",
        "title": "Open Browser",
        "description": "Opens a browser surface, at a given address when one is supplied.",
        "audiences": ["plugin", "user"],
        "effects": {
          "kind": "write",
          "idempotency": "none",
          "confirmation": "never",
          "external": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1, "maxLength": 16384 }
          }
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false
        },
        "palette": {
          "category": "Open",
          "icon": "globe",
          "keywords": ["web", "url", "site", "internet"],
          "launcher": true,
          "fillsPane": true
        }
      }
    ]
  },
  "settings": [
    {
      "key": "homeURL",
      "label": "Home URL",
      "type": "string",
      "default": "https://duckduckgo.com",
      "group": "Home & search"
    },
    {
      "key": "searchEngine",
      "label": "Search engine",
      "type": "select",
      "default": "https://duckduckgo.com/?q=",
      "group": "Home & search",
      "options": [
        {
          "value": "https://duckduckgo.com/?q=",
          "label": "DuckDuckGo"
        },
        {
          "value": "https://www.google.com/search?q=",
          "label": "Google"
        },
        {
          "value": "https://www.bing.com/search?q=",
          "label": "Bing"
        }
      ]
    }
  ]
}
