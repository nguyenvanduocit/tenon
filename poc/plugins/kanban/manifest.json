{
  "id": "dev.tenon.kanban",
  "name": "kanban",
  "displayName": "Kanban",
  "icon": "checklist",
  "version": "0.2.0",
  "permissions": [
    "filesystem.read",
    "filesystem.write",
    "terminal.read",
    "terminal.write",
    "workspace.control"
  ],
  "events": {
    "publishes": ["board.changed"],
    "observes": []
  },
  "intents": {
    "uses": [
      "filesystem.file.read.v1",
      "filesystem.file.write.v1",
      "workspace.pane.owner.v1",
      "workspace.content.open.v1",
      "workspace.pane.focus.v1",
      "terminal.open.v1",
      "terminal.viewport.read.v1"
    ],
    "provides": [
      {
        "name": "dev.tenon.kanban.open.v1",
        "title": "Kanban: Open Board",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Open", "icon": "checklist", "keywords": ["kanban", "board", "tasks", "todo"], "launcher": true, "fillsPane": true }
      }
    ]
  }
}
