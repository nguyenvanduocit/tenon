        "palette": { "category": "Split", "icon": "rectangle.split.2x1", "keywords": ["pane", "vertical", "divide"], "key": "cmd+d", "launcher": true }
      },
      {
        "name": "dev.tenon.core-commands.pane.split-down.v1",
        "title": "Split Down",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Split", "icon": "rectangle.split.1x2", "keywords": ["pane", "horizontal", "divide"], "key": "cmd+shift+d", "launcher": true }
      },
      {
        "name": "dev.tenon.core-commands.pane.close.v1",
        "title": "Close Pane",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "destructive", "idempotency": "none", "confirmation": "policy", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Workspace", "icon": "xmark.square", "keywords": ["pane", "slot", "remove"], "key": "cmd+w" }
      },
