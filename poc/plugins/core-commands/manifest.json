        "name": "dev.tenon.core-commands.tab.next.v1",
        "title": "Next Tab",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Workspace", "icon": "arrow.right", "keywords": ["tab", "forward", "cycle"], "key": "cmd+shift+]" }
      },
      {
        "name": "dev.tenon.core-commands.tab.previous.v1",
        "title": "Previous Tab",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Workspace", "icon": "arrow.left", "keywords": ["tab", "back", "cycle"], "key": "cmd+shift+[" }
      },
      {
        "name": "dev.tenon.core-commands.pane.focus-next.v1",
        "title": "Focus Next Pane",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Workspace", "icon": "arrow.forward.square", "keywords": ["pane", "slot", "cycle", "focus"], "key": "cmd+]" }
      },
      {
        "name": "dev.tenon.core-commands.workspace.switch.v1",
        "title": "Switch Workspace…",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "Workspace", "icon": "square.stack", "keywords": ["workspace", "switch", "project"] }
      }
