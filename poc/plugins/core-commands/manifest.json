{
  "id": "dev.tenon.core-commands",
  "name": "core-commands",
  "version": "0.1.0",
  "permissions": ["workspace.control"],
  "intents": {
    "uses": [
      "workspace.tab.create.v1",
      "workspace.pane.split.v1",
      "workspace.pane.close.v1",
      "workspace.tab.next.v1",
      "workspace.tab.previous.v1",
      "workspace.pane.focus-next.v1",
      "workspace.state.v1",
      "workspace.select.v1",
      "ui.pick.v1"
    ],
    "provides": [
      {
        "name": "dev.tenon.core-commands.tab.new.v1",
        "title": "New Tab",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "New", "icon": "plus.square", "keywords": ["tab", "create", "open"], "key": "cmd+t", "launcher": true }
      },
      {
        "name": "dev.tenon.core-commands.terminal.new.v1",
        "title": "New Terminal",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "outputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
        "palette": { "category": "New", "icon": "terminal", "keywords": ["shell", "term", "console"], "launcher": true, "fillsPane": true }
      },
      {
        "name": "dev.tenon.core-commands.pane.split-right.v1",
        "title": "Split Right",
        "audiences": ["plugin", "user"],
        "effects": { "kind": "write", "idempotency": "none", "confirmation": "never", "external": false },
        "inputSchema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false },
